# Occulta is testnet-only. There is no mainnet configuration — see SECURITY.md and
# docs/THREAT-MODEL.md before changing any of this.
#
# Nothing in this file is a secret. This app has no backend and no server-side
# credentials of any kind (build spec §1) — every value here is public configuration
# read by the browser.

NEXT_TELEMETRY_DISABLED=1

# Default indexer/relayer/RPC endpoints, shown to the user as "operated by someone; here
# is what they can see" (build spec §4.5) before anything is submitted through them. The
# user can override all three in Settings; these are just the pre-filled defaults.
NEXT_PUBLIC_DEFAULT_INDEXER_URL=
NEXT_PUBLIC_DEFAULT_RELAYER_URL=
NEXT_PUBLIC_DEFAULT_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Path to the deployment manifest this build reads contract IDs and circuit VK hashes
# from (build spec §2, "Contract IDs come from deployments/testnet.json"). Never
# hardcode an ID instead of reading this file.
NEXT_PUBLIC_DEPLOYMENTS_URL=/deployments/testnet.json
